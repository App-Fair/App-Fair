// Xcode build settings for the iOS app; Xcode's own settings and `day build` override them.
// https://daybrite.dev/docs/reference/project-structure#xcode-build-settings

// Fallbacks for a checkout that has not built yet; the generated include below sets these from
// Day.toml [app] and Cargo.toml [package] on every `day build`.
PRODUCT_NAME = AppFair
DAY_APP_TITLE = App Fair
PRODUCT_BUNDLE_IDENTIFIER = org.appfair.AppFair
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// The oldest iOS the app runs on. `day build` raises it when a Day piece needs a newer one.
// 17.4 is MarketplaceKit's first release, which App Fair installs apps through.
IPHONEOS_DEPLOYMENT_TARGET = 17.4

// The alternative app marketplace entitlement and the App Group shared with the marketplace
// extension. Day drops whatever the provisioning profile does not grant, with a warning.
CODE_SIGN_ENTITLEMENTS = $(DAY_PROJECT_ROOT)/platform/ios/AppFair.entitlements
// 1 = iPhone, 2 = iPad.
TARGETED_DEVICE_FAMILY = 1,2

// Any other build setting goes here, for example:
//INFOPLIST_KEY_UIRequiresFullScreen = YES

// Generated by `day build` from Day.toml.
#include? "../../build/day/xcconfig/ios.xcconfig"

// Per-checkout settings such as DEVELOPMENT_TEAM, gitignored and applied last.
#include? "DayApp.local.xcconfig"
